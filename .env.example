# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Model providers. Leave a key empty to hide that provider's models.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Shared password for uploads, prompts, runs and the playground.
# Empty in development = no password. Empty in production = read-only.
APP_PASSWORD=""

# Optional spending guards (defaults shown)
# MAX_CASES_PER_RUN=100
# MAX_RUNS_PER_HOUR=10
# MAX_OUTPUT_TOKENS=4096
